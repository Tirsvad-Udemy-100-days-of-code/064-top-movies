# Formatting of the shell scripts: `shfmt -d` (or `shfmt -w`) reads this file, so
# the setting is declared once and scripts/test-shell-format.sh checks it.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.{py,toml,yml,yaml,md}]
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_size = 2
